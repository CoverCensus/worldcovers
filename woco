#!/usr/bin/env bash
# Run commands in the installed environment without changing dependencies.
set -e
HERE="$(cd "$(dirname "$0")" && pwd)"

# Setup must work before the environment exists.
if [[ "${1:-}" == "setup" ]]; then
    shift
    exec "$HERE/tools/setup.sh" "$@"
fi

if [[ ! -x "$HERE/.venv/bin/python" ]]; then
    echo "Missing Python environment: $HERE/.venv/bin/python" >&2
    echo "Run uv sync for development, or uv sync --no-dev --frozen on a server." >&2
    exit 1
fi

exec "$HERE/.venv/bin/python" "$HERE/woco_cli.py" "$@"
